APP_NAME="Evgeny Birthday"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://CHANGE-ME
DOMAIN=CHANGE-ME
# https: нужен сертификат в certs/. http: только для тестов, без сертификата.
NGINX_MODE=https
APP_KEY=

DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_SECURE_COOKIE=true

# Ссылка на чат гостей (Telegram или WhatsApp)
INVITATION_CHAT_URL=https://t.me/

# Пароль к списку гостей на /host/login. Пустой — список закрыт.
INVITATION_HOST_PASSWORD=
